#!/usr/bin/env bash
# ccmsg launcher — resolves the plugin root through any symlink chain, then hands
# off to the bun-run CLI. Distribution is bun-runtime only (no compiled binary),
# so bun is a hard requirement; both the Claude Code hooks and shell users invoke
# this one script.
#
# Alias it from your shell (e.g. `alias ccmsg=/path/to/bin/ccmsg`) to use it
# without polluting PATH.
#
# The launcher runs the CLI of the plugin it belongs to and nothing else: it
# neither hands over to a `ccmsg` found on PATH nor rewrites one (DR-0032
# §2.2-4). Which version runs is decided by whoever invoked it — the hooks by the
# plugin root Claude Code resolved, a shell user by the path they put on PATH.
#
# Functions are defined unconditionally so this file can be `source`d for
# testing; the launch logic itself only runs when executed directly (the
# BASH_SOURCE/0 guard at the bottom).

# Chases a symlink chain to an absolute real path (relative links resolved
# against their containing directory at each hop).
__ccmsg_resolve_symlink() {
  local __p="$1"
  while [ -L "$__p" ]; do
    local __link
    __link="$(readlink "$__p")"
    case "$__link" in
      /*) __p="$__link" ;;
      *)  __p="$(cd "$(dirname "$__p")" && pwd -P)/$__link" ;;
    esac
  done
  printf '%s' "$(cd "$(dirname "$__p")" && pwd -P)/$(basename "$__p")"
}

# Dependency self-heal: `claude plugin install/update` materializes the plugin
# cache but never runs a package-manager install, so a fresh cache has no
# node_modules. The runtime side survives that (bun auto-install resolves from
# the global cache), but the daemon's serve-time `Bun.build` of the webui
# client does not — it needs a real node_modules, and a daemon that started
# without one keeps failing even after a later install because the process
# caches module resolution. Installing here, before any bun process starts,
# closes both gaps. Best-effort and silent: a failed install leaves the
# runtime path no worse than it was.
__ccmsg_ensure_deps() {
  local __root="$1"
  [ -f "$__root/bun.lock" ] || return 0
  [ -d "$__root/node_modules" ] && return 0
  command -v bun >/dev/null 2>&1 || return 0
  (cd "$__root" && bun install --frozen-lockfile >/dev/null 2>&1) || true
  return 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  __self="$(__ccmsg_resolve_symlink "${BASH_SOURCE[0]}")"
  __here="$(cd "$(dirname "$__self")" && pwd)"
  __cli="${__here}/../packages/cli/src/index.ts"

  __ccmsg_ensure_deps "${__here}/.." 2>/dev/null || true

  if command -v bun >/dev/null 2>&1; then
    exec bun run "$__cli" "$@"
  else
    echo "ccmsg: bun not found. Install bun to run ccmsg." >&2
    echo "  https://bun.sh/" >&2
    exit 1
  fi
fi
