#!/usr/bin/env bash
# ccmsg launcher — resolves the plugin root through any symlink chain, then hands
# off to the bun-run CLI. Distribution is bun-runtime only (no compiled binary),
# so bun is a hard requirement; both the Claude Code hooks and shell users invoke
# this one script.
#
# From a shell or a launchd script, call it through the PATH launcher
# (packages/cli/path-launcher.sh, placed by `just install-launcher`), which
# execs this file of the version Claude Code has installed.
#
# The launcher runs the CLI of the plugin it belongs to and nothing else: it
# neither hands over to a `ccmsg` found on PATH nor rewrites one (DR-0032
# §2.2-4). Which version runs is decided by whoever invoked it — the hooks by the
# plugin root Claude Code resolved, a shell user by the path they put on PATH.
#
# Functions are defined unconditionally so this file can be `source`d for
# testing; the launch logic itself only runs when executed directly (the
# BASH_SOURCE/0 guard at the bottom).

# Chases a symlink chain to an absolute real path (relative links resolved
# against their containing directory at each hop).
__ccmsg_resolve_symlink() {
  local __p="$1"
  while [ -L "$__p" ]; do
    local __link
    __link="$(readlink "$__p")"
    case "$__link" in
      /*) __p="$__link" ;;
      *)  __p="$(cd "$(dirname "$__p")" && pwd -P)/$__link" ;;
    esac
  done
  printf '%s' "$(cd "$(dirname "$__p")" && pwd -P)/$(basename "$__p")"
}

# Dependency self-heal: `claude plugin install/update` materializes the plugin
# cache but never runs a package-manager install, so a fresh cache has no
# node_modules. The runtime side survives that (bun auto-install resolves from
# the global cache), but the daemon's serve-time `Bun.build` of the webui
# client does not — it needs a real node_modules, and a daemon that started
# without one keeps failing even after a later install because the process
# caches module resolution. Installing here, before any bun process starts,
# closes both gaps.
#
# "Installed" is a marker that only a finished install leaves in node_modules,
# not node_modules itself: bun creates node_modules as an install starts, and
# from then on stops auto-installing, so a call that took the directory for a
# finished install would run on a half-filled one and fail with `Cannot find
# package`. The first calls into a fresh version often come together (the
# post-push upgrade, session hooks, a launchd job), and `bun install` does not
# exclude a second install in the same directory, so the install runs under an
# exclusive lock. A call that finds no marker waits for the lock, looks for the
# marker again, and installs if it is still missing — after a failed install or
# one killed half way as well. Best-effort and silent: a failed install leaves
# no marker, and the CLI runs anyway.
__CCMSG_DEPS_MARKER=".ccmsg-deps-installed"
__ccmsg_ensure_deps() {
  local __root="$1"
  [ -f "$__root/bun.lock" ] || return 0
  [ -f "$__root/node_modules/$__CCMSG_DEPS_MARKER" ] && return 0
  command -v bun >/dev/null 2>&1 || return 0
  # The lock is flock(2) on an open bun.lock, taken with flock(1) (Linux) or
  # lockf(1) (macOS); without either the install runs unlocked. The kernel drops
  # it when the last process holding fd 9 ends, so a killed holder leaves no
  # lock behind, and an install outliving its launcher still holds it. fd 9
  # lives only in this subshell and the install it starts: the CLI exec'd later
  # starts the daemon, which would otherwise hold the lock for its lifetime.
  # Design rationale: the lock is on bun.lock, which the install reads and
  # (frozen) never writes, rather than on a lock file of its own, so the plugin
  # cache gets nothing besides node_modules.
  (
    exec 9<"$__root/bun.lock" || exit 0
    if command -v flock >/dev/null 2>&1; then
      flock 9
    elif command -v lockf >/dev/null 2>&1; then
      lockf -s 9
    fi
    [ -f "$__root/node_modules/$__CCMSG_DEPS_MARKER" ] && exit 0
    cd "$__root" && bun install --frozen-lockfile >/dev/null 2>&1 &&
      : >"node_modules/$__CCMSG_DEPS_MARKER"
  ) || true
  return 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  __self="$(__ccmsg_resolve_symlink "${BASH_SOURCE[0]}")"
  __here="$(cd "$(dirname "$__self")" && pwd)"
  __cli="${__here}/../packages/cli/src/index.ts"

  __ccmsg_ensure_deps "${__here}/.." 2>/dev/null || true

  if command -v bun >/dev/null 2>&1; then
    exec bun run "$__cli" "$@"
  else
    echo "ccmsg: bun not found. Install bun to run ccmsg." >&2
    echo "  https://bun.sh/" >&2
    exit 1
  fi
fi
