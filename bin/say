#!/bin/bash
# ccmsg-say-shim
#
# PATH shim: a `say` that also records which Claude Code session spoke.
#
# Install a copy of this file as `say` in a PATH dir ahead of /usr/bin, and
# every `say` — yours, a script's, an agent's — routes through `ccmsg say`,
# which forwards the arguments to /usr/bin/say unchanged after noting the
# speech in the session's 1on1 room. The webui can then answer "which of these
# sessions just made a sound", which bare macOS `say` cannot.
#
# ccmsg is resolved through PATH (it is installed there by the same SessionStart
# flow that installs this shim). If it is missing, speech still happens — a
# broken observation path must never cost the user their audio.
#
# Recursion is structurally impossible: `ccmsg say` execs the absolute
# /usr/bin/say, never a PATH lookup that would find this file again.
#
# The `ccmsg-say-shim` marker on line 2 is how the SessionStart hook recognises
# its own shim: a `say` on PATH without it belongs to someone else and is left
# alone.
command -v ccmsg >/dev/null 2>&1 && exec ccmsg say "$@"
exec /usr/bin/say "$@"
