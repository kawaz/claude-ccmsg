#!/bin/bash
# ccmsg-say-shim
#
# PATH shim: a `say` that also records which Claude Code session spoke.
#
# Install a copy of this file as `say` in a PATH dir ahead of /usr/bin, and
# every `say` — yours, a script's, an agent's — routes through the ccmsg
# plugin launcher's `say`,
# which forwards the arguments to /usr/bin/say unchanged after noting the
# speech in the session's 1on1 room. The webui can then answer "which of these
# sessions just made a sound", which bare macOS `say` cannot.
#
# The launcher is named by absolute path, filled in by the SessionStart hook
# when it stages the copy to install (this file itself carries a placeholder).
# PATH's `ccmsg` is a different tool that has no `say`. The launcher lives in a
# versioned plugin cache dir that vanishes on update; until the hook proposes
# the re-rendered copy, speech still happens through the fallback — a broken
# observation path must never cost the user their audio.
#
# Recursion is structurally impossible: the launcher's `say` execs the absolute
# /usr/bin/say, never a PATH lookup that would find this file again.
#
# The `ccmsg-say-shim` marker on line 2 is how the SessionStart hook recognises
# its own shim: a `say` on PATH without it belongs to someone else and is left
# alone.
launcher='@CCMSG_LAUNCHER@'
[ -x "$launcher" ] && exec "$launcher" say "$@"
exec /usr/bin/say "$@"
