{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": [
        "hooks/bundle.ts",
        "hooks/composer-fill.ts",
        "hooks/composer-fill.test.ts",
        "hooks/composer-fill.bundle.test.ts",
        "packages/protocol/src/parse.ts",
        "packages/protocol/src/sidecar.ts",
        "packages/protocol/test/parse.test.ts",
        "packages/protocol/test/sidecar.test.ts",
        "packages/protocol/src/request.ts",
        "packages/protocol/src/request-files.ts",
        "packages/protocol/src/request-host.ts",
        "packages/protocol/src/request-rooms.ts",
        "packages/protocol/src/request-sessions.ts",
        "packages/protocol/src/request-transcripts.ts",
        "packages/protocol/test/request.test.ts",
        "packages/protocol/src/storage-event.ts",
        "packages/protocol/src/session-status.ts",
        "packages/protocol/src/response.ts",
        "packages/protocol/src/response-rooms.ts",
        "packages/protocol/src/response-sessions.ts",
        "packages/protocol/src/response-files.ts",
        "packages/protocol/src/response-transcripts.ts",
        "packages/protocol/src/response-host.ts",
        "packages/protocol/src/stream-event.ts",
        "packages/protocol/src/frame.ts",
        "packages/protocol/test/response.test.ts",
        "packages/protocol/test/stream-event.test.ts",
        "packages/protocol/test/frame.test.ts",
        "packages/protocol/src/json-value.ts",
        "packages/protocol/src/transcript-content.ts",
        "packages/protocol/src/transcript-attachment.ts",
        "packages/protocol/src/transcript-row.ts",
        "packages/protocol/src/transcript-tool-result.ts",
        "packages/protocol/src/agent-meta.ts",
        "packages/protocol/test/transcript-row.test.ts",
        "packages/protocol/test/transcript-rows.ts",
        "packages/daemon/src/direct-send.ts",
        "packages/daemon/src/http.ts",
        "packages/daemon/src/log.ts",
        "packages/daemon/src/server.ts",
        "packages/daemon/src/session-launch.ts",
        "packages/daemon/src/session-input.ts",
        "packages/daemon/src/sidecar-call.ts",
        "packages/daemon/src/wire-line.ts",
        "packages/daemon/src/fs-access.ts",
        "packages/daemon/src/fs-find.ts",
        "packages/daemon/src/session-rename.ts",
        "packages/daemon/src/fork-origin.ts",
        "packages/daemon/src/virtual-sessions.ts",
        "packages/daemon/src/transcript.ts",
        "packages/daemon/src/session-search.ts",
        "packages/daemon/src/session-status.ts",
        "packages/daemon/src/session-errors.ts",
        "packages/daemon/src/session-user-input.ts",
        "packages/daemon/src/session-dump.ts",
        "packages/daemon/src/agent-transcripts.ts",
        "packages/cli/src/client.ts",
        "packages/webui/src/client/ws.ts",
        "packages/daemon/test/log.test.ts",
        "packages/daemon/test/sidecar-call.test.ts",
        "packages/daemon/test/helpers.ts",
        "packages/daemon/test/drive-request.ts",
        "packages/protocol/src/ccmsg-direct-transcript.ts",
        "packages/webui/src/client/transcript-model.ts",
        "packages/webui/src/client/components/Timeline.tsx",
        "packages/webui/src/client/timeline-auto-open.ts",
        "packages/webui/src/client/utils.ts",
        "packages/webui/src/client/navigation.ts",
        "packages/webui/src/client/files-view-store.ts",
        "packages/webui/src/client/components/session-input-store.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error"
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules", "docs", "hooks/composer-fill.bundle.js"]
}
